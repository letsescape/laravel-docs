{
  "schema_version": 1,
  "workflow_timeout_seconds": 7200,
  "unit_test_command": ["uv", "run", "--directory", "translation-sync", "--locked", "--python", "3.14", "python", "-m", "unittest", "discover", "-s", "tests"],
  "replay_command": ["uv", "run", "--directory", "translation-sync", "--locked", "--python", "3.14", "python", "replay.py"],
  "provider_fixture_command": ["uv", "run", "--directory", "translation-sync", "--locked", "--python", "3.14", "python", "provider_check.py"],
  "candidate_setup_commands": [["npm", "ci"]],
  "sync_core_command": ["uv", "run", "--directory", "translation-sync", "--locked", "--python", "3.14", "python", "main.py"],
  "site_validation_commands": [
    ["npm", "run", "test:markdown-links"],
    ["npm", "run", "typecheck", "--", "--pretty", "false"],
    ["npm", "run", "build"],
    ["npm", "run", "validate-anchors"]
  ],
  "path_validation_command": ["uv", "run", "--directory", "translation-sync", "--locked", "--python", "3.14", "python", "validate_generated_changes.py"],
  "deploy_workflow": "deploy.yml"
}
