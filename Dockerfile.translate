# 문서 동기화·번역용 Python 런타임
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

ENV UV_CACHE_DIR=/home/app/.cache/uv \
    UV_PROJECT_ENVIRONMENT=/home/app/.venv

RUN groupadd --system app && \
    useradd --system --gid app --home-dir /home/app --create-home app && \
    mkdir -p /home/app/.cache/uv /home/app/.venv /workspace && \
    chown -R app:app /home/app

USER app
WORKDIR /workspace

ENTRYPOINT ["uv", "run", "--directory", "/workspace/translation-sync", "--locked", "--no-build", "--python", "3.14", "python", "/workspace/translation-sync/main.py"]
