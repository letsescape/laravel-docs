# 격리 번역 workflow용 런타임 (Node 24 + Python 3.14 + uv + git + gh)
FROM node:24-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates gh git && \
    rm -rf /var/lib/apt/lists/*

RUN npm install --global @openai/codex@latest --registry=https://registry.npmjs.org && \
    codex --version

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON_BIN_DIR=/usr/local/bin \
    UV_CACHE_DIR=/home/app/.cache/uv \
    UV_PROJECT_ENVIRONMENT=/home/app/.venv

RUN uv python install 3.14 && \
    groupadd --system app && \
    useradd --system --gid app --home-dir /home/app --create-home app && \
    mkdir -p /artifacts /home/app/.cache/uv /home/app/.venv /workspace && \
    git config --system --add safe.directory /workspace && \
    chown -R app:app /artifacts /home/app /workspace

USER app
WORKDIR /workspace

# 저장소는 compose에서 read-only로 mount하고 candidate와 phase state는 /artifacts의 별도 volume에만 기록
ENTRYPOINT ["uv", "run", "--directory", "/workspace/translation-sync", "--locked", "--python", "3.14", "python", "/workspace/translation-sync/workflow.py"]
