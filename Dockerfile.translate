FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY .github/docs-updater/pyproject.toml .github/docs-updater/uv.lock .github/docs-updater/

RUN cd .github/docs-updater && uv sync --frozen --no-dev

COPY .github/docs-updater/ .github/docs-updater/

WORKDIR /app/.github/docs-updater

CMD ["uv", "run", "python", "main.py"]
