{
  "name": "laravel-docs",
  "version": "1.0.0",
  "description": "The Laravel Korean documentation.",
  "main": "index.js",
  "scripts": {
    "docusaurus": "docusaurus",
    "postbuild": "node scripts/create-latest-doc-redirects.mjs",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "node scripts/serve-build.mjs",
    "serve:docusaurus": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test:markdown-links": "node --test scripts/markdown-link-utils.test.mjs",
    "test:security": "node --test scripts/create-latest-doc-redirects.test.mjs src/remark/validate-local-assets.test.mjs src/rehype/safe-html.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker run --rm --ipc=host -v \"$PWD:/work\" -v laravel-docs-playwright-node-modules:/work/node_modules -w /work -p 3000:3000 mcr.microsoft.com/playwright:v1.60.0-noble bash -lc \"npm ci && NODE_OPTIONS=--max-old-space-size=4096 PLAYWRIGHT_PORT=3000 npx playwright test\"",
    "test:e2e:ui": "playwright test --ui",
    "validate-anchors": "node scripts/validate-anchors.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letsescape/laravel-docs-web.git"
  },
  "keywords": [],
  "author": "kimchanhyung98",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/letsescape/laravel-docs-web/issues"
  },
  "homepage": "https://github.com/letsescape/laravel-docs-web#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.1",
    "@docusaurus/utils": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/mdast": "^4.0.4",
    "husky": "^9.1.7"
  },
  "overrides": {
    "webpackbar": "^7.0.0"
  }
}
