{
  "name": "laravel-docs",
  "version": "1.0.0",
  "description": "The Laravel Korean documentation.",
  "main": "index.js",
  "scripts": {
    "docusaurus": "docusaurus",
    "sync:versions": "node translation-sync/scripts/sync-versioned-links.mjs",
    "prestart": "npm run sync:versions",
    "prebuild": "npm run sync:versions",
    "postbuild": "node translation-sync/scripts/create-latest-doc-redirects.mjs",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "node translation-sync/scripts/serve-build.mjs",
    "serve:docusaurus": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test:markdown-links": "node --test translation-sync/scripts/markdown-link-utils.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker build --tag laravel-docs-playwright:node26 - < Dockerfile.playwright && docker run --rm --ipc=host -v \"$PWD:/work\" -v laravel-docs-playwright-node-modules:/work/node_modules -w /work -p 3000:3000 laravel-docs-playwright:node26 bash -lc \"npm ci && NODE_OPTIONS=--max-old-space-size=4096 PLAYWRIGHT_PORT=3000 npx playwright test\"",
    "test:e2e:ui": "playwright test --ui",
    "validate-anchors": "node translation-sync/scripts/validate-anchors.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letsescape/laravel-docs.git"
  },
  "keywords": [],
  "author": "kimchanhyung98",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/letsescape/laravel-docs/issues"
  },
  "homepage": "https://github.com/letsescape/laravel-docs#readme",
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/mdast": "^4.0.4",
    "husky": "^9.1.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "serialize-javascript": "^7.0.7",
    "uuid": "^11.1.1",
    "webpackbar": "^7.0.0"
  }
}
