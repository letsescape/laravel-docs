# 모델 설정
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-5

# OpenAI 설정
OPENAI_API_KEY=

# Azure 설정
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-05-01-preview

# 안정성 / 재시도 (Task 1)
# TRANSLATION_REQUEST_TIMEOUT=120        # OpenAI 한 호출 timeout (초)
# TRANSLATION_SDK_RETRIES=0              # SDK 자체 재시도. 0 권장 (우리 retry 와 중복 방지)
# TRANSLATION_MAX_ATTEMPTS=3             # 파일 단위 재시도 횟수
# TRANSLATION_CHUNK_MAX_ATTEMPTS=2       # 청크 단위 재시도 횟수
# TRANSLATION_DELAY=0                    # 파일 사이 sleep (초)

# 로컬 CLI 번역 설정
# TRANSLATION_PROVIDER=cli
# TRANSLATION_CLI_COMMAND="codex exec --sandbox read-only --skip-git-repo-check -"
# TRANSLATION_CLI_TIMEOUT=1800
